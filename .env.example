# Smartlead serverless proxy secrets (server-side only — NOT exposed to the browser).
# Set these in Vercel: Project → Settings → Environment Variables.
# For local dev with `vercel dev`, copy this file to `.env` and fill it in.

SMARTLEAD_JWT=your_smartlead_jwt_here

# Required for Bulk Sync (campaign email-account membership writes).
SMARTLEAD_API_KEY=

# Durable Smartlead inbox snapshot. Use a pooled Postgres connection string
# from your Vercel database integration (Neon, Supabase pooler, or equivalent).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Random 32+ character value used by Vercel to authenticate scheduled syncs.
CRON_SECRET=
